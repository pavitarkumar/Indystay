# ==============================================================================
# IndiStay — Environment Variables Template
# Copy this file to '.env.local' for local development:
#   cp .env.example .env.local
#
# IMPORTANT: NEVER commit your real database passwords or secrets to Git!
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:3000

# Allowed CORS Origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5000

# MongoDB Database Connection String
# Example local: mongodb://127.0.0.1:27017/indistay
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/indistay?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/indistay

# JWT Authentication Secret Key (Generate a random 32+ char key)
AUTH_SECRET=your_32_characters_random_jwt_secret_key_here

# Cloudinary Media Storage (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Transactional Email (Optional - Resend)
RESEND_API_KEY=
EMAIL_FROM=notifications@indistay.com
