# IndiStay Production-Grade Hotel Booking Platform Environment Variables

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/indistay

# Authentication
AUTH_SECRET=indistay_super_secret_session_jwt_key_32_characters_minimum_example
APP_URL=http://localhost:3000

# Cloudinary (Optional for local development; server fallback adapter is provided if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Transactional Email (Optional, console mock logger active by default)
RESEND_API_KEY=
EMAIL_FROM=notifications@indistay.com

# Initial Super Admin (Used by scripts/seed.ts)
INITIAL_SUPER_ADMIN_NAME=IndiStay Platform Admin
INITIAL_SUPER_ADMIN_EMAIL=admin@indistay.com
INITIAL_SUPER_ADMIN_PASSWORD=IndiStayAdmin#2026!
INITIAL_SUPER_ADMIN_PHONE=+919876543210

# Direct UPI & QR Scanner Configuration
NEXT_PUBLIC_UPI_ID=pavitarkumar@upi
NEXT_PUBLIC_UPI_NAME="PAVITAR KUMAR"
